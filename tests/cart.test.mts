import {test} from 'node:test';import assert from 'node:assert/strict';import {useCartStore} from '../src/lib/store.ts';
const item={id:'11111111-1111-4111-8111-111111111111',name:'Test item',price:12.05,quantity:1,image:'',stock_quantity:3};
test('decrement, removal and aggregate stock cap',()=>{const s=useCartStore; s.setState({items:[]});assert.equal(s.getState().addToCart({...item,color:'blue'}),true);s.getState().addToCart({...item,color:'blue'});s.getState().setQuantity(item.id,'blue',1);assert.equal(s.getState().items[0].quantity,1);s.getState().addToCart({...item,color:'pink'});s.getState().addToCart({...item,color:'pink'});assert.equal(s.getState().addToCart(item),false);s.getState().removeFromCart(item.id,'blue');assert.equal(s.getState().items.length,1);assert.equal(s.getState().items[0].color,'pink');assert.equal(s.getState().total(),24.1);s.getState().setQuantity(item.id,'pink',0);assert.equal(s.getState().items.length,0);});
